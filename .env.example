# Zkopíruj jako `.env` (je v .gitignore) pro lokální běh.
# Provozní režimy jsou tři a liší se tím, ODKUD přijdou credentials.

# ── 1. local-stdio (výchozí) ─────────────────────────────────────────────────
# Jeden uživatel, credentials z env. Tohle chceš při vývoji a v Claude Desktop.
OPENMCP_MODE=local-stdio

# Credentials se čtou jako <SLUG>_<KEY> velkými písmeny — přesně podle
# `credentials` v connector.yaml. Demo instance: https://demo.flexibee.eu:5434,
# firma `demo`, uživatel/heslo winstrom/winstrom.
ABRAFLEXI_API_URL=https://firma.flexibee.eu:5434
ABRAFLEXI_COMPANY=vloz-kod-firmy
ABRAFLEXI_USERNAME=vloz-uzivatele
ABRAFLEXI_PASSWORD=vloz-heslo

# Operátorské přepínače: <SLUG>_<KEY>
# ABRAFLEXI_READ_ONLY=true
# ABRAFLEXI_REDACT_PII=true
# ABRAFLEXI_REDACT_NAMES=false
# ABRAFLEXI_REQUIRE_WRITE_CONFIRMATION=true

# PII salt. Bez něj konektor s `runtime.pii_salt: true` NENASTARTUJE — a je to
# záměr: tichý fallback na náhodný salt by zrušil stabilitu tokenů a projevilo
# by se to až po prvním restartu podu.
#   openssl rand -hex 32
OPENMCP_PII_SALT=vygeneruj-si-vlastni

# ── 2. hosted (multi-tenant, za gatewayí) ────────────────────────────────────
# Tohle nastavuje platforma, ne ty. Credentials jdou z Vaultu per uživatel.
# OPENMCP_MODE=hosted
# OPENMCP_INTERNAL_TOKEN=<z k8s secretu openmcp-internal>
# VAULT_ADDR=https://vault.openmcp.svc:8200
# VAULT_ROLE=abraflexi

# ── 3. self-hosted (bez gatewaye, vlastní OIDC) ──────────────────────────────
# OPENMCP_MODE=self-hosted
# OIDC_ISSUER=https://idp.example.com/realms/x
# OIDC_JWKS_URI=https://idp.example.com/realms/x/protocol/openid-connect/certs

# ── Ladění ───────────────────────────────────────────────────────────────────
# OPENMCP_LOG_LEVEL=DEBUG
# OPENMCP_LOG_FORMAT=text     # čitelnější než výchozí JSON
# OPENMCP_LOG_SETUP=false     # nech nastavení loggingu na volajícím
